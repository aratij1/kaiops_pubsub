FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend/src/common:/app/backend/src/api-gateway:/app/backend/src/application-onboarding:/app/backend/src/alert-intelligence:/app/backend/src/audit-service:/app/backend/src/connector-hub:/app/backend/src/dashboard-generator:/app/backend/src/discovery-service:/app/backend/src/orchestrator:/app/backend/src/knowledge-development-worker:/app/backend/src/metrics-validation-agent:/app/backend/src/prometheus-config-service:/app/backend/src/rule-generation-agent:/app/backend/src/approval-service:/app/backend/src/remediation-engine:/app/backend/src/closure-service:/app/backend/src/validation-agent:/app/backend/src/monitoring-adapter:/app/backend/src/notification-service:/app/backend/src/temporal-pilot:/app/ai-workbench/src:/app/ai-workbench/src/context-agent:/app/ai-workbench/src/model-router:/app/ai-workbench/src/resolution-agent:/app/ai-workbench/src/evaluation-service

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/docker/requirements.service.txt ./requirements.service.txt

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --upgrade pip \
    && pip install --require-hashes -r requirements.service.txt

COPY pyproject.toml README.md ./
COPY backend/src ./backend/src
COPY backend/config ./backend/config
COPY backend/rag ./rag
COPY scripts/remediation ./scripts/remediation
COPY scripts/apply-migrations.py ./scripts/apply-migrations.py
COPY backend/database/schema.sql ./backend/database/schema.sql
COPY backend/database/migrations ./backend/database/migrations
COPY ai-workbench/src ./ai-workbench/src

ARG KAIMS_RELEASE_SHA=dev
ARG KAIMS_BUILD_TIME=unknown
ENV KAIMS_RELEASE_SHA=${KAIMS_RELEASE_SHA} \
    KAIMS_BUILD_TIME=${KAIMS_BUILD_TIME}

EXPOSE 8000
