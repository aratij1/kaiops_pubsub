FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend/src/common:/app/backend/src/api-gateway:/app/backend/src/application-onboarding:/app/backend/src/alert-intelligence:/app/backend/src/audit-service:/app/backend/src/dashboard-generator:/app/backend/src/discovery-service:/app/backend/src/orchestrator:/app/backend/src/metrics-validation-agent:/app/backend/src/prometheus-config-service:/app/backend/src/rule-generation-agent:/app/backend/src/approval-service:/app/backend/src/remediation-engine:/app/backend/src/closure-service:/app/backend/src/validation-agent:/app/backend/src/monitoring-adapter:/app/backend/src/notification-service:/app/ai-workbench/src:/app/ai-workbench/src/context-agent:/app/ai-workbench/src/model-router:/app/ai-workbench/src/resolution-agent:/app/ai-workbench/src/evaluation-service

WORKDIR /app

COPY pyproject.toml README.md ./
COPY backend/src ./backend/src
COPY backend/rag ./rag
COPY ai-workbench/src ./ai-workbench/src

RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .

EXPOSE 8000
