def approvedCommand(String command) {
    def value = (command ?: '').trim()
    def patterns = [
        ~/^kubectl\s+(get|describe|logs)\b.*/,
        ~/^kubectl\s+(rollout\s+(restart|undo|status)|scale)\b.*/,
        ~/^ansible-playbook\s+playbooks\/[A-Za-z0-9_.\/-]+\.ya?ml\b.*/,
        ~/^redis-cli\s+-h\s+[A-Za-z0-9_.-]+\s+-n\s+\d+\s+FLUSHDB$/,
        ~/^terraform\s+(init|apply)\b.*/,
        ~/^mysql\s+-e\s+"CALL mysql\.rds_failover\(\);"$/,
        ~/^curl --fail --silent --show-error( --output \/dev\/null)?( --retry \d+)?( --retry-all-errors)?( --retry-connrefused)?( --retry-delay \d+)?( -X POST)? http:\/\/[A-Za-z0-9_.:-]+\/[A-Za-z0-9_.\/?=&-]+$/
    ]
    return value && value.length() <= 1000 && !value.contains('\n') && patterns.any { value ==~ it }
}

def runGovernedCommand(String label, String command, boolean dryRun) {
    if (!approvedCommand(command)) { error("Command is outside the remediation allowlist: ${command}") }
    if (dryRun) { echo "DRY RUN [${label}]: ${command}"; return }
    if (isUnix()) { sh(label: label, script: command) } else { bat(label: label, script: command) }
}

pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '20'))
        preserveStashes(buildCount: 5)
        durabilityHint('MAX_SURVIVABILITY')
        skipDefaultCheckout(true)
    }
    parameters {
        string(name: 'KAI_OPS_INCIDENT_ID', trim: true)
        string(name: 'KAI_OPS_APPROVAL_ID', trim: true)
        string(name: 'KAI_OPS_APPLICATION_ID', trim: true)
        string(name: 'KAI_OPS_TARGET', trim: true)
        string(name: 'KAI_OPS_SERVICE', trim: true)
        string(name: 'KAI_OPS_ENVIRONMENT', defaultValue: 'prod', trim: true)
        string(name: 'KAI_OPS_NAMESPACE', defaultValue: 'default', trim: true)
        string(name: 'KAI_OPS_RESOLUTION_ID', defaultValue: 'investigate-first', trim: true)
        string(name: 'KAI_OPS_POLICY_VERSION', defaultValue: 'jenkins-self-healing-v2', trim: true)
        booleanParam(name: 'KAI_OPS_DRY_RUN', defaultValue: true)
        text(name: 'KAI_OPS_EXECUTION_PLAN', defaultValue: '{"schema_version":"kaiops.remediation.v2","commands":[],"preflight":[],"validation_commands":[],"rollback_commands":[]}')
    }
    stages {
        stage('Govern request') {
            steps {
                milestone ordinal: 10, label: 'governed-request'
                script {
                    if (!(params.KAI_OPS_INCIDENT_ID ==~ /[A-Za-z0-9_.:-]{3,128}/)) { error('A valid KaiOps incident id is required') }
                    if (!(params.KAI_OPS_TARGET ==~ /[A-Za-z0-9_.-]{1,128}/)) { error('The remediation target contains unsafe characters') }
                    if (!(params.KAI_OPS_NAMESPACE ==~ /[a-z0-9]([a-z0-9.-]*[a-z0-9])?/)) { error('The Kubernetes namespace is invalid') }
                    def plan = readJSON text: params.KAI_OPS_EXECUTION_PLAN, returnPojo: true
                    def mutating = params.KAI_OPS_RESOLUTION_ID != 'investigate-first'
                    def commands = plan.commands instanceof List ? plan.commands : []
                    def preflight = plan.preflight instanceof List ? plan.preflight : []
                    def validation = plan.validation_commands instanceof List ? plan.validation_commands : []
                    def rollback = plan.rollback_commands instanceof List ? plan.rollback_commands : []
                    def rollbackMode = (plan.rollback_mode ?: 'automatic') as String
                    if (mutating && !params.KAI_OPS_APPROVAL_ID?.trim()) { error('A persisted KaiOps approval id is required for a mutating resolution') }
                    if (mutating && !commands) { error('The governed plan contains no remediation commands') }
                    if (mutating && !params.KAI_OPS_DRY_RUN && (!preflight || !validation)) { error('Live self-healing requires executable preflight and validation commands') }
                    if (mutating && !params.KAI_OPS_DRY_RUN && rollbackMode == 'automatic' && !rollback) { error('An automatic rollback mode requires executable rollback commands') }
                    def rejected = [*commands, *preflight, *validation, *rollback].findAll { !approvedCommand(it as String) }
                    if (rejected) { error("Plan contains commands outside the allowlist: ${rejected.join(', ')}") }
                    env.KAI_OPS_PLAN_JSON = writeJSON(json: [commands: commands, preflight: preflight, validation: validation, rollback: rollback, rollback_mode: rollbackMode], returnText: true)
                    currentBuild.description = "${params.KAI_OPS_RESOLUTION_ID} | ${params.KAI_OPS_INCIDENT_ID} | ${params.KAI_OPS_TARGET}"
                    writeJSON file: 'kaiops-request.json', json: [schema_version:'kaiops.remediation.audit.v2', incident_id:params.KAI_OPS_INCIDENT_ID, approval_id:params.KAI_OPS_APPROVAL_ID, application_id:params.KAI_OPS_APPLICATION_ID, target:params.KAI_OPS_TARGET, environment:params.KAI_OPS_ENVIRONMENT, namespace:params.KAI_OPS_NAMESPACE, resolution_id:params.KAI_OPS_RESOLUTION_ID, policy_version:params.KAI_OPS_POLICY_VERSION, dry_run:params.KAI_OPS_DRY_RUN, build_url:env.BUILD_URL]
                }
            }
        }
        stage('Preflight evidence') {
            steps { script {
                def plan = readJSON text: env.KAI_OPS_PLAN_JSON, returnPojo: true
                plan.preflight.each { runGovernedCommand('Preflight evidence', it as String, params.KAI_OPS_DRY_RUN) }
                env.KAI_OPS_PREFLIGHT_PASSED = 'true'
            } }
        }
        stage('Remediate, verify, recover') {
            steps {
                milestone ordinal: 20, label: 'before-mutation'
                script {
                    def plan = readJSON text: env.KAI_OPS_PLAN_JSON, returnPojo: true
                    try {
                        plan.commands.each { runGovernedCommand('Approved remediation', it as String, params.KAI_OPS_DRY_RUN) }
                        env.KAI_OPS_EXECUTED = 'true'
                        retry(3) { plan.validation.each { runGovernedCommand('Recovery validation', it as String, params.KAI_OPS_DRY_RUN) } }
                        env.KAI_OPS_VALIDATED = 'true'
                    } catch (failure) {
                        env.KAI_OPS_FAILURE = failure.message.take(500)
                        if (!params.KAI_OPS_DRY_RUN && env.KAI_OPS_EXECUTED == 'true' && plan.rollback_mode == 'automatic' && plan.rollback) {
                            env.KAI_OPS_ROLLBACK_ATTEMPTED = 'true'
                            plan.rollback.reverseEach { runGovernedCommand('Automatic rollback', it as String, false) }
                            env.KAI_OPS_ROLLBACK_SUCCEEDED = 'true'
                        }
                        throw failure
                    }
                }
            }
        }
        stage('Publish recovery evidence') {
            steps {
                milestone ordinal: 30, label: 'validated-recovery'
                script { writeJSON file: 'kaiops-result.json', json: [schema_version:'kaiops.remediation.result.v2', incident_id:params.KAI_OPS_INCIDENT_ID, approval_id:params.KAI_OPS_APPROVAL_ID, resolution_id:params.KAI_OPS_RESOLUTION_ID, target:params.KAI_OPS_TARGET, dry_run:params.KAI_OPS_DRY_RUN, preflight_passed:env.KAI_OPS_PREFLIGHT_PASSED == 'true', executed:env.KAI_OPS_EXECUTED == 'true', recovery_validated:env.KAI_OPS_VALIDATED == 'true', rollback_attempted:env.KAI_OPS_ROLLBACK_ATTEMPTED == 'true', rollback_succeeded:env.KAI_OPS_ROLLBACK_SUCCEEDED == 'true', result:'SUCCESS', completed_at:new Date().format("yyyy-MM-dd'T'HH:mm:ssXXX")] }
            }
        }
    }
    post {
        always { script {
            if (!fileExists('kaiops-result.json')) { writeJSON file: 'kaiops-result.json', json: [schema_version:'kaiops.remediation.result.v2', incident_id:params.KAI_OPS_INCIDENT_ID, approval_id:params.KAI_OPS_APPROVAL_ID, resolution_id:params.KAI_OPS_RESOLUTION_ID, target:params.KAI_OPS_TARGET, dry_run:params.KAI_OPS_DRY_RUN, preflight_passed:env.KAI_OPS_PREFLIGHT_PASSED == 'true', executed:env.KAI_OPS_EXECUTED == 'true', recovery_validated:false, rollback_attempted:env.KAI_OPS_ROLLBACK_ATTEMPTED == 'true', rollback_succeeded:env.KAI_OPS_ROLLBACK_SUCCEEDED == 'true', result:currentBuild.currentResult, failure:env.KAI_OPS_FAILURE ?: ''] }
            archiveArtifacts artifacts: 'kaiops-request.json,kaiops-result.json', fingerprint: true, allowEmptyArchive: false
        } }
    }
}
