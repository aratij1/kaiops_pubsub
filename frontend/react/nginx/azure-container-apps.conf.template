server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  proxy_connect_timeout 5s;
  proxy_send_timeout 120s;
  proxy_read_timeout 120s;

  location /api-gateway/ {
    rewrite ^/api-gateway/?(.*)$ /$1 break;
    proxy_pass https://${API_GATEWAY_HOST};
    proxy_http_version 1.1;
    proxy_set_header Host ${API_GATEWAY_HOST};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
  }

  location /monitoring-adapter/ {
    rewrite ^/monitoring-adapter/?(.*)$ /$1 break;
    proxy_pass https://${MONITORING_ADAPTER_HOST};
    proxy_set_header Host ${MONITORING_ADAPTER_HOST};
  }

  location /approval-service/ {
    rewrite ^/approval-service/?(.*)$ /$1 break;
    proxy_pass https://${APPROVAL_SERVICE_HOST};
    proxy_set_header Host ${APPROVAL_SERVICE_HOST};
  }

  location = /index.html { add_header Cache-Control "no-store" always; try_files $uri =404; }
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable" always; try_files $uri =404; }
  location / { try_files $uri /index.html; }
}
