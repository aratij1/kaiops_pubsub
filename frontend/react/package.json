{
  "name": "kaiops-ui-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8501",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "build:budget": "npm run build && npm run check:bundle",
    "build:storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "test:unit": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "check:architecture": "node ../../scripts/check_architecture_budgets.mjs",
    "quality": "npm run lint && npm run check:architecture && npm run typecheck && npm run test:unit",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 8501",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-virtual": "^3.10.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-aria-components": "^1.5.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "storybook": "^10.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  }
}
