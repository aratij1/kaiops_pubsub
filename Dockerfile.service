FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend/src/common:/app/backend/src/api-gateway:/app/backend/src/alert-intelligence:/app/backend/src/orchestrator:/app/backend/src/context-agent:/app/backend/src/model-router:/app/backend/src/resolution-agent:/app/backend/src/approval-service:/app/backend/src/remediation-engine:/app/backend/src/closure-service:/app/backend/src/monitoring-adapter

WORKDIR /app

COPY pyproject.toml README.md ./
COPY backend/src ./backend/src
COPY backend/rag ./rag

RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .

EXPOSE 8000
