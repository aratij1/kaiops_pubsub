# KaiMS capacity profile: sustained 1,000 alerts/minute (16.7 alerts/second).
# Copy only the values you need into .env. Keep one canonical event bus.
EVENT_BUS_PROVIDER=rabbitmq
MESSAGE_BUS_DEFAULT_PROVIDER=rabbitmq
MESSAGE_BUS_DYNAMIC_ROUTING=true
MESSAGE_BUS_STREAM_THRESHOLD=250

# Fast deterministic admission, normalization, deduplication and correlation.
ALERT_INTELLIGENCE_WORKER_COUNT=8
ALERT_INTELLIGENCE_PREFETCH_COUNT=16
ALERT_INTELLIGENCE_DB_POOL_SIZE=20
ALERT_INTELLIGENCE_DB_MAX_OVERFLOW=30
DISCOVERY_LLM_ENABLED=false

# Bound expensive evidence/RCA work independently from ingestion.
CONTEXT_AGENT_WORKER_COUNT=2
RESOLUTION_AGENT_WORKER_COUNT=2
RABBITMQ_CONSUMER_PREFETCH_COUNT=2
CONTEXT_STRATEGY=continuous

# Keep operational projections current while writing in batches.
INCIDENT_PROJECTION_INTERVAL_SECONDS=5
INCIDENT_PROJECTION_BATCH_SIZE=500
ALERTMANAGER_DEDUP_TTL_SECONDS=900
ALERTMANAGER_DEDUP_MAX_ENTRIES=50000
