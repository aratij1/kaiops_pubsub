# Cloud-neutral runtime template.
# Copy to a provider-specific env file and change values only; do not edit code
# when migrating between Azure, AWS, GCP, or on-prem infrastructure.

ENVIRONMENT=prod
CLOUD_PROVIDER=cloud-neutral
DEPLOYMENT_PROFILE=cloud-neutral
CONNECTION_CONFIG_PATH=backend/config/kaiops-connections.json

# Jira Cloud lifecycle (credentials and webhook token belong in a secret store).
JIRA_API_BASE_URL=https://kaiops-test.atlassian.net
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Bug
JIRA_API_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
JIRA_TRANSITION_MAPPING={}

# Public/load-balancer front door
PUBLIC_BASE_URL=https://kaiops.example.com
TRUST_X_FORWARDED_FOR=true

# AI layer endpoints. Point these at a separate VM, namespace, cluster, or cloud ingress.
AI_LAYER_MODE=endpoint
AI_LAYER_REQUEST_TIMEOUT_SECONDS=120
AI_LAYER_AUTH_TOKEN=
CONTEXT_AGENT_URL=http://context-agent:8000
RESOLUTION_AGENT_URL=http://resolution-agent:8000
MODEL_ROUTER_URL=http://model-router:8000
EVALUATION_SERVICE_URL=http://evaluation-service:8000

# Shared state. For multi-VM or Kubernetes, these must point to shared services.
DB=mysql
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_USER=kaiops
DB_PASSWORD=change-me
DB_DATABASE=kaiops
DATABASE_URL=mysql+aiomysql://kaiops:change-me@mysql.example.internal:3306/kaiops
REDIS_URL=redis://redis.example.internal:6379/0

# Message bus. Use one provider per environment.
EVENT_BUS_PROVIDER=rabbitmq
MESSAGE_BUS_DEFAULT_PROVIDER=rabbitmq
MESSAGE_BUS_WORKER_COUNT=2
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka.example.internal:9092
RABBITMQ_URL=amqp://kaiops:change-me@rabbitmq.example.internal:5672/
RABBITMQ_EXCHANGE=kaiops.events
RABBITMQ_QUEUE_PREFIX=kaiops

# Optional managed Azure services. Leave disabled for AWS/GCP/on-prem.
AZURE_SERVICE_BUS_ENABLED=false
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_CONTENT_SAFETY_ENABLED=false
AZURE_OPENAI_EMBEDDINGS_ENABLED=false
AZURE_AI_EVALUATION_ENABLED=false
OBSERVABILITY_AZURE_MONITOR_ENABLED=false

# RAG/vector services. Use provider-native endpoints behind the same app contract.
AZURE_AI_SEARCH_ENABLED=false
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX_NAME=kaiops-rag

# Secrets must be unique per environment.
JWT_SECRET_KEY=replace-with-strong-random-secret
ADMIN_USER_PASSWORD=replace-with-strong-password
EXECUTIVE_USER_PASSWORD=replace-with-strong-password
L3_USER_PASSWORD=replace-with-strong-password
L2_USER_PASSWORD=replace-with-strong-password
L1_USER_PASSWORD=replace-with-strong-password

# LLM provider can migrate independently of cloud provider.
MODEL_GATEWAY_PROVIDER=router
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
