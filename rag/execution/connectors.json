{
  "version": "connectors-v1",
  "default_connector": "generic-api",
  "connectors": {
    "orders-db": {
      "connector_id": "orders-db-api",
      "system": "orders-db",
      "type": "api",
      "endpoint": "https://orders-db.internal/api",
      "auth_method": "service-account-token",
      "secret_ref": "vault://kaiops/prod/orders-db-token",
      "allowed_operations": ["read_status", "failover_database", "verify_replication_health"]
    },
    "payments": {
      "connector_id": "payments-k8s",
      "system": "payments-api",
      "type": "kubernetes",
      "cluster": "prod-us-east-1",
      "namespace": "payments",
      "auth_method": "kubeconfig-service-account",
      "secret_ref": "vault://kaiops/prod/payments-kubeconfig",
      "allowed_operations": ["read_status", "rollback_deployment", "restart_pod", "verify_slo"]
    },
    "generic-api": {
      "connector_id": "generic-api",
      "system": "generic",
      "type": "api",
      "endpoint": "https://api.internal",
      "auth_method": "service-account-token",
      "secret_ref": "vault://kaiops/prod/default-token",
      "allowed_operations": ["read_status"]
    }
  }
}
