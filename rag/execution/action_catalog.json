{
  "version": "actions-v1",
  "commands": {
    "check_replication_lag": {
      "operation": "read_status",
      "command": "GET /replication/lag",
      "safety": "read-only"
    },
    "check_primary_cpu": {
      "operation": "read_status",
      "command": "GET /metrics/cpu?node=primary",
      "safety": "read-only"
    },
    "failover_database": {
      "operation": "failover_database",
      "command": "POST /database/failover {\"target\":\"healthy-replica\"}",
      "safety": "reversible",
      "rollback": "POST /database/failback {\"target\":\"previous-primary\"}"
    },
    "validate_replication_recovery": {
      "operation": "verify_replication_health",
      "command": "GET /replication/health",
      "safety": "read-only"
    },
    "check_checkout_latency": {
      "operation": "read_status",
      "command": "promql: histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"payments\",path=\"/checkout\"}[5m])) by (le))",
      "safety": "read-only"
    },
    "rollback_deployment": {
      "operation": "rollback_deployment",
      "command": "kubectl rollout undo deployment/payments-api -n payments",
      "safety": "reversible",
      "rollback": "kubectl rollout undo deployment/payments-api --to-revision=<previous> -n payments"
    },
    "validate_checkout_slo": {
      "operation": "verify_slo",
      "command": "promql: p95_checkout_latency_ms < 1200 and error_rate < 2%",
      "safety": "read-only"
    }
  }
}
