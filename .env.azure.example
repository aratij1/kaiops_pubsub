# Azure VM environment overrides for docker-compose.yml
# Usage on the Azure VM:  cp .env.azure.example .env.azure && edit it, then
#                         docker compose --env-file .env.azure up -d --build
# (or copy it to .env on the VM, since docker compose auto-loads .env)
#
# This file is a TEMPLATE — fill in real secrets on the VM only, in your own
# .env.azure copy. .env.azure is gitignored: real secrets never get committed.

# --- Deployment mode ---
# REQUIRED on the VM: must be a non-local value (e.g. "prod") so the checks
# below actually run. Left as "local" (or unset), the app assumes a trusted
# dev machine and skips secret-strength validation entirely.
ENVIRONMENT=prod

# --- MySQL credentials (blank = uses docker-compose defaults: kaiops/kaiops, root) ---
# REQUIRED before the VM is reachable by others: set strong values.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- RabbitMQ credentials (blank = uses docker-compose defaults: guest/guest) ---
# REQUIRED before the VM is reachable by others: set strong values.
# Avoid "@", ":", "/", or other URL-special characters — the password is
# embedded directly into an amqp:// connection string.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# --- Application auth (blank = insecure demo defaults, e.g. Admin@123456) ---
# REQUIRED on the VM. Passwords must be 12+ chars with upper/lower/number/special.
JWT_SECRET_KEY=
ADMIN_USER_PASSWORD=
EXECUTIVE_USER_PASSWORD=
L3_USER_PASSWORD=
L2_USER_PASSWORD=
L1_USER_PASSWORD=

# --- Ingested alerts storage path ---
# Blank = defaults to ../kaiops-data/ingested_alerts (outside the project folder,
# auto-created). On the Azure VM, point this at a data disk if you have one,
# e.g. /datadisk/kaiops/ingested_alerts (Linux) or D:/kaiops-data/ingested_alerts (Windows).
INGESTED_ALERTS_HOST_PATH=

# --- LLM provider keys (only OPENAI_API_KEY is actually used by the model router) ---
OPENAI_API_KEY=
OPENAI_GPT5_MODEL=gpt-5
OPENAI_GPT4O_MODEL=gpt-4o
# Defined in config but not wired into any provider yet — safe to leave blank:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LOCAL_LLM_ENABLED=false

# --- SMTP (email notifications) ---
# Optional: leave SMTP_ENABLED=false to leave email notifications off.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=
NOTIFICATION_RECIPIENT_EMAILS=

