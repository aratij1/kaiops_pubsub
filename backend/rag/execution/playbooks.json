    {
      "id": "workflow-execution-failure-playbook",
      "name": "Workflow execution failure recovery",
      "match": {
        "alert_ids": [],
        "services": ["remediation-engine", "orchestrator", "context-agent", "resolution-agent", "approval-service", "kaiops-platform"],
        "alert_types": ["workflow", "execution", "agent_failure"],
        "alert_keywords": ["workflowexecutionfailure", "automationexecutionfailure", "execution failure", "workflow failed", "agent failed"]
      },
      "risk_tier": "high",
      "preflight_checks": [
        "Failed workflow id identified",
        "Failed stage and retry safety reviewed",
        "Approval is present before retry"
      ],
      "steps": [
        {
          "name": "Collect workflow execution diagnostics",
          "type": "diagnostic",
          "commands": ["check_workflow_execution_status", "query_message_bus_depth", "check_api_gateway_health"]
        },
        {
          "name": "Retry failed workflow if approved",
          "type": "remediation",
          "approval_gate": true,
          "commands": ["retry_failed_workflow"]
        },
        {
          "name": "Validate workflow recovery",
          "type": "validation",
          "commands": ["validate_workflow_recovery"]
        }
      ]
    },
    {
      "id": "onboarding-smoke-flow-playbook",
      "name": "Onboarding smoke flow validation",
      "match": {
        "alert_ids": [],
        "services": ["kaiops-platform", "api-gateway", "kaiops-core1", "mysql"],
        "alert_types": ["onboarding", "smoke_test", "monitoring_rule_onboarding"],
        "alert_keywords": ["onboarding-smoke-test", "smoke test", "rule onboarding", "monitoring-rule-onboarding"]
      },
      "risk_tier": "low",
      "preflight_checks": [
        "Project name and generated rules are known",
        "Prometheus rule file exists",
        "No live mutation is required for smoke validation"
      ],
      "steps": [
        {
          "name": "Collect onboarding smoke diagnostics",
          "type": "diagnostic",
          "commands": ["check_api_gateway_health", "check_prometheus_alerts"]
        },
        {
          "name": "Validate onboarding smoke path",
          "type": "validation",
          "commands": ["validate_onboarding_smoke_flow", "check_prometheus_alerts"]
        },
        {
          "name": "Validate KaiOps triage script dry run",
          "type": "validation",
          "commands": ["check_kaiops_triage_script_dry_run"]
        }
      ]
    },
    {
      "id": "generic-kaiops-triage-playbook",
      "name": "Generic KaiOps guarded triage",
      "match": {
        "alert_ids": [],
        "services": [],
        "alert_types": [],
        "alert_keywords": []
      },
      "risk_tier": "medium",
      "preflight_checks": [
        "Connector health check attempted",
        "Incident context and alert payload are available",
        "Human approval required before any live remediation"
      ],
      "steps": [
        {
          "name": "Collect generic KaiOps diagnostics",
          "type": "diagnostic",
          "commands": ["check_api_gateway_health", "check_prometheus_alerts", "check_kaiops_triage_script_dry_run"]
        },
        {
          "name": "Validate current service state",
          "type": "validation",
          "commands": ["validate_service_recovery"]
        }
      ]
    }
  ]
}
